## Convert a Cmp to a signed integer: Lt(n) => 0 - n, Gt(n) => n, Eq => 0.
## Match must cover all three constructors (Eq last, as a wildcard-like arm).
type Cmp = Lt(Int) | Eq | Gt(Int)

fn cmp_value(c: Cmp) -> Int
  effects {} {
  match c with {
    Lt(n) => 0 - n,
    Gt(n) => n,
    Eq    => 0
  }
}
