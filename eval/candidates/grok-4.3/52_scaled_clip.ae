fn clip_to_cap(x: Int, cap: Int{c: c >= 0}) -> Int
  effects {} {
  if x <= cap { x } else { cap }
}

fn scaled_clip(x: Int, base: Int, max_cap: Int{c: c >= 0}) -> Int
  where result >= base && result <= base + max_cap
  effects {} {
  if x < 0 {
    let clipped = 0;
    let r = base + clipped;
    r
  } else if x > max_cap {
    let clipped = max_cap;
    let r = base + clipped;
    r
  } else {
    let clipped = x;
    let r = base + clipped;
    r
  }
}
