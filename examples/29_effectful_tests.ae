## Showcase: test/bench/snap blocks may use any built-in effect.
## Since the parser desugars them to fns with {Async,FS,IO,Net,Rand,State,Throw},
## the effect checker never rejects effectful builtins called from inside them.

import std::uuid
import std::random

## IO effect: print inside a test block is fine.
test "io effect in test block" {
  print("running io test")
  assert(true)
}

## Rand effect: random_int and uuid_v4 no longer require removing tests.
test "rand effect — degenerate range" {
  assert_eq(random_int(7, 7), 7)
}

test "rand effect — uuid length" {
  assert_eq(len(uuid_v4()), 36)
}

## Throw effect: assert triggers Throw on failure; covered implicitly by every test,
## but made explicit here.
test "throw effect — assert_eq passes" {
  assert_eq(1 + 1, 2)
}

fn main() -> Unit effects {IO, Rand} {
  print("all effects allowed in test blocks")
  print("uuid = ${uuid_v4()}")
  print("rand(1,10) = ${str(random_int(1, 10))}")
}
