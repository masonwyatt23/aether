## Add a bounded delta (0..10) to start.
## Precondition: delta in [0, 10] (encoded in the type of delta).
## Contract: result >= start AND result <= start + 10 (proved at compile time).
fn accumulate_step(start: Int, delta: Int{d: d >= 0 && d <= 10}) -> Int
  where result >= start && result <= start + 10
  effects {} {
  let stepped = start + delta
  stepped
}
