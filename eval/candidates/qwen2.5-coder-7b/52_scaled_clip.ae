fn clip_to_cap(x: Int, cap: Int{c: c >= 0}) -> Int
  effects {} {
  if x <= cap then x else cap
}

fn scaled_clip(x: Int, base: Int, max_cap: Int{c: c >= 0}) -> Int
  where result >= base && result <= base + max_cap
  effects {} {
  let clipped = clip_to_cap(x, max_cap);
  if clipped == 0 then let r = base + clipped in r else let r = base + clipped in r
}
