## std::hash — Hashing utilities: fast default hash and SHA-256.
##
## `hash_default` uses Rust's DefaultHasher (fast, non-cryptographic).
## `hash_sha256` uses the sha2 crate (cryptographic, stable across runs).

## Return the 64-bit default hash of `s` as a signed integer.
## Useful as a cache key or fingerprint within a single process.
fn hash_default(s: Str) -> Int effects {} {
  hash_default_native(s)
}

## Return the SHA-256 digest of `s` as a lowercase hex string (64 chars).
## Example: hash_sha256("hello") == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
fn hash_sha256(s: Str) -> Str effects {} {
  hash_sha256_native(s)
}
