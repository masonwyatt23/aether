## Clamp x to [lo, hi] then add offset.
## Precondition: hi >= lo (encoded in the type of hi).
## Contract: result >= lo + offset AND result <= hi + offset (proved at compile time).
fn clamp_and_offset(x: Int, lo: Int, hi: Int{h: h >= lo}, offset: Int) -> Int
  where result >= lo + offset && result <= hi + offset
  effects {} {
  if x < lo then
    let c = lo
    let r = c + offset
    r
  else if x > hi then
    let c = hi
    let r = c + offset
    r
  else
    let c = x
    let r = c + offset
    r
}
