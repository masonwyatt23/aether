## Snapshot testing example.
##
## Run with: aether snap examples/17_snapshots.ae
## Update:   aether snap examples/17_snapshots.ae --update

import std::iter

fn clamp(n: Int, lo: Int, hi: Int) -> Int effects {} {
    if n < lo {
        lo
    } else {
        if n > hi {
            hi
        } else {
            n
        }
    }
}

snap "clamp behavior" {
    snap_expect("zero", str(clamp(50, 0, 100)))
    snap_expect("low",  str(clamp(-5, 0, 100)))
    snap_expect("high", str(clamp(200, 0, 100)))
}

fn main() -> Unit effects {} { () }
