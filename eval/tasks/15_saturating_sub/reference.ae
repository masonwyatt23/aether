## Saturating subtraction: returns a - b, clamped to 0 from below.
## Preconditions: a >= 0 and b >= 0 (encoded in parameter types).
## Contract: result >= 0, result <= a, AND result >= a - b (proved at compile time).
fn saturating_sub(a: Int{x: x >= 0}, b: Int{x: x >= 0}) -> Int
  where result >= 0 && result <= a && result >= a - b
  effects {} {
  if a > b then a - b else 0
}
