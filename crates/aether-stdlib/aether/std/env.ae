## std::env — environment variable access.
##
## `env_get` and `env_has` are pure at the Aether level (they only read process
## state that does not change within a single evaluation).  `env_set` mutates
## process state and therefore carries the `State` effect.

## Return the value of environment variable `name`, or the empty string if it
## is not set.
fn env_get(name: Str) -> Str effects {} {
  env_get_native(name)
}

## Return true iff the environment variable `name` is set (even if empty).
fn env_has(name: Str) -> Bool effects {} {
  env_has_native(name)
}

## Set environment variable `name` to `value` in the current process.
fn env_set(name: Str, value: Str) -> Unit effects {State} {
  env_set_native(name, value)
}
