## Clamp x into the half-open interval [lo, hi).
## Precondition: hi >= lo + 1 (non-empty interval, encoded in hi's type).
## Contract: result >= lo AND result <= hi - 1 (proved at compile time).
fn clamp_exclusive(x: Int, lo: Int, hi: Int{h: h >= lo + 1}) -> Int
  where result >= lo && result <= hi - 1
  effects {} {
  if x < lo then lo else if x > hi - 1 then hi - 1 else x
}
