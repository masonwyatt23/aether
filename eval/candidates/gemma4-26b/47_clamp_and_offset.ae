fn clamp_and_offset(x: Int, lo: Int, hi: Int{h: h >= lo}, offset: Int) -> Int
  where result >= lo + offset && result <= hi + offset
  effects {} {
  if x < lo {
    let c = lo
    let r = c + offset
    r
  } else if x > hi {
    let c = hi
    let r = c + offset
    r
  } else {
    let c = x
    let r = c + offset
    r
  }
}
