fn two_stage_bound(x: Int, lo: Int, hi: Int{h: h >= lo}) -> Int
  where result >= lo && result <= hi
  effects {} {
  if x < lo {
    let stage1 = lo;
    if stage1 > hi { hi } else { stage1 }
  } else if x > hi {
    let stage1 = hi;
    if stage1 < lo { lo } else { stage1 }
  } else {
    let stage1 = x;
    if stage1 < lo {
      lo
    } else if stage1 > hi {
      hi
    } else {
      stage1
    }
  }
}
