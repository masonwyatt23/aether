## Idiomatic error handling via the `Result` ADT in `std::result`.
##
## `Result = Ok(Str) | Err(Str)` — match destructures the success or failure.

import std::result

fn parse_command(input: Str) -> Result effects {} {
  if input == "" then Err("empty command")
  else if input == "help" then Ok("show available commands")
  else if input == "exit" then Ok("session terminated")
  else Err("unknown command")
}

fn describe(r: Result) -> Str effects {} {
  match r with {
    Ok(msg)  => "OK: " ++ msg,
    Err(why) => "ERR: " ++ why
  }
}

test "ok path" {
  assert_eq(describe(parse_command("help")), "OK: show available commands")
}

test "err path" {
  assert_eq(describe(parse_command("blah")), "ERR: unknown command")
}

test "unwrap_or fallback" {
  let r = parse_command("oops")
  assert_eq(result_unwrap_or(r, "fallback"), "fallback")
}

fn main() -> Unit effects {IO} {
  print(describe(parse_command("help")))
  print(describe(parse_command("invalid")))
}
